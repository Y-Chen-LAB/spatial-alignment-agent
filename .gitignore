*.sif
/logs

# Per-method baseline environments and their caches (rebuilt from the run_*_baseline.py docstrings)
/.method-venv-*/
/.method-cache/
# Baseline outputs: aligned coordinates and scores per task and method (GBs; regenerate with the run_*_baseline scripts)
/results/baselines

