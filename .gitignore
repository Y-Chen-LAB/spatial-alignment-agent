# Environments and build artefacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.DS_Store

# Large input data and run directories.
/agent_runs
/benchmarks/spatial_alignment/compiled_data
*.h5ad
*.h5ad.gz

