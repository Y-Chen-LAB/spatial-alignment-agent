{
  "name": "spatial_alignment_bench",
  "version": "0.1.0",
  "description": "Agent-runnable spatial genomics alignment benchmark tasks derived from SABench tutorial and paper-aligned public data.",
  "model_free_task_specs": true,
  "model_policy": "Tasks define data, instructions, output schema, and scoring only. Agent/model choices are supplied by runner metadata or CLI flags.",
  "runner_plugin": "benchmarks/spatial_alignment/runner_plugin.json",
  "task_glob": "benchmarks/spatial_alignment/tasks/*/task.toml",
  "workspace_root": "agent_workspaces",
  "prompt_file": "TASK.md",
  "submission_dir": "submission",
  "required_output_dir": "submission/aligned_coordinates",
  "required_csv_columns": [
    "obs_id",
    "x",
    "y"
  ],
  "prepare_command": "uv run python scripts/prepare_agent_task.py {task} --workspace-root agent_workspaces --force",
  "score_command": "uv run python scripts/score_agent_submission.py {task} {workspace}/submission --output {workspace}/scores.json",
  "score_file": "{workspace}/scores.json",
